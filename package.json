    "express-session": "^1.17.3",
    "express-mysql-session": "^3.0.0",
    "mysql2": "^3.6.5",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "uuid": "^9.0.1",
